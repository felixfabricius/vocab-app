# Runs on GitHub Actions macOS runners only (see .github/workflows/ios.yml). Never needed on Windows.
default_platform(:ios)

PROJECT = "ios/App/App.xcodeproj"
APP_ID = "in.fabricius.vocab"
WIDGETS_ID = "in.fabricius.vocab.widgets"
TARGETS = { "App" => APP_ID, "ALaLunaWidgets" => WIDGETS_ID }

def profile_name(id)
  ENV.fetch("sigh_#{id}_appstore_profile-name")
end

platform :ios do
  desc "Build, sign with match, upload to TestFlight (internal testing)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true
    )

    setup_ci # temporary keychain on the runner

    match(
      type: "appstore",
      app_identifier: TARGETS.values,
      api_key: api_key,
      readonly: false,
      force: ENV["FORCE_MATCH"] == "true"
    )

    TARGETS.each do |target, id|
      update_code_signing_settings(
        path: PROJECT,
        use_automatic_signing: false,
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        code_sign_identity: "Apple Distribution",
        bundle_identifier: id,
        targets: [target],
        profile_name: profile_name(id)
      )
    end

    increment_build_number(xcodeproj: PROJECT, build_number: ENV.fetch("BUILD_NUMBER"))

    build_app(
      project: PROJECT,
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "ALaLuna.ipa",
      buildlog_path: "fastlane/logs",
      cloned_source_packages_path: "SourcePackages",
      export_options: { provisioningProfiles: TARGETS.values.to_h { |id| [id, profile_name(id)] } }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
